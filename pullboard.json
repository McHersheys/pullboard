{
  "name": "pullboard",
  "itemSizeBudget": 150,
  "maintainers": ["olevicor@icloud.com"],
  "gate": "npm run gate",
  "affectedTests": "node bin/run-tests.js",
  "submitGate": "landing",
  "submitDeferAbove": 20,
  "landingShards": 6,
  "submit": { "requireInfraNote": true },
  "claim": { "reopenFirstRefusalMinutes": 30 },
  "submitInvariants": [
    "test/refusal-next-steps.test.js",
    "test/machine.test.js"
  ],
  "registryGuards": [
    {
      "inputs": [
        "src/api.js",
        "src/serve.js",
        "src/native-board-state.js",
        "src/native-state-clock.js",
        "src/relay-presentation.js",
        "src/exchange.js",
        "src/board-schema.js",
        "src/board-schema-source.js",
        "src/formats/board-schema.json",
        "src/machine.js",
        "src/move-registry.js",
        "relay/browser-model.js"
      ],
      "tests": [
        "test/relay-parity.test.js",
        "test/relay-parity-clock.test.js"
      ]
    },
    {
      "inputs": [
        "src/moves/**",
        "src/recorded-move.js",
        "src/api-moves.js",
        "src/move-registry.js",
        "src/discovery.js"
      ],
      "tests": [
        "test/relay-credential.test.js",
        "test/move-registry.test.js"
      ]
    },
    {
      "inputs": [
        "src/**",
        "docs/formats.md"
      ],
      "tests": [
        "docs/formats.test.js"
      ]
    },
    {
      "inputs": [
        "src/help.js",
        "src/commands/**",
        "src/cli-main.js"
      ],
      "tests": [
        "test/readme.test.js"
      ]
    },
    {
      "inputs": [
        "relay/**",
        "docs/architecture.md"
      ],
      "tests": [
        "docs/architecture.test.js"
      ]
    }
  ],
  "spec": "SPEC.md",
  "verify": { "policy": "any", "unrelatedTrunkMoves": true, "composeAtAdmission": true },
  "lease": "2h",
  "lanes": {
    "core": {
      "owns": [
        "src/",
        "bin/",
        "test/",
        "package.json",
        ".github/workflows/",
        "relay/",
        "docs/api.md",
        "docs/api.test.js",
        "docs/lifecycle.md",
        "docs/formats.md",
        "docs/formats.test.js", "docs/architecture.md", "docs/architecture.test.js", "docs/img/lifecycle.svg", "docs/img/lifecycle-dark.svg", "docs/img/draw.mjs"
      ],
      "specs": [
        "B",
        "V",
        "L",
        "S",
        "C",
        "R",
        "I",
        "A",
        "H",
        "E"
      ],
      "starts": "now"
    },
    "tests": {
      "owns": [],
      "specs": [
        "P"
      ],
      "starts": "any time: verifiers check submitted work and own no folders"
    },
    "docs": {
      "owns": [
        "docs/",
        "README.md",
        "test/readme.test.js",
        "skills/",
        "DOCTRINE.md",
        "PRACTICE.md",
        "CODE_OF_CONDUCT.md",
        "CHANGELOG.md",
        ".github/ISSUE_TEMPLATE/",
        ".github/pull_request_template.md",
        "CONTRIBUTING.md"
      ],
      "specs": [
        "I"
      ],
      "starts": "now"
    },
    "view": {
      "owns": [
        "src/cockpit.js",
        "src/serve.js",
        "src/view.css",
        "src/view/",
        "test/cockpit.test.js",
        "test/cockpit/",
        "test/journeys.test.js"
      ],
      "specs": [
        "N26",
        "N27",
        "N28"
      ],
      "starts": "now"
    }
  },
  "shared": ["test/chrome-fixture.js", "test/cockpit/fixture.js"],
  "commits": {
    "requireIds": [
      "feat",
      "fix"
    ],
    "noEmoji": true,
    "noHostName": true
  },
  "staticChecks": "node --experimental-vm-modules --disable-warning=ExperimentalWarning bin/static-style-checks.js",
  "flakes": {
    "rerun": true
  },
  "relay": { "outbox": true }
}
